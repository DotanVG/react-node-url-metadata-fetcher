# Port the API listens on. Most hosts (Render, Railway, Fly) inject this.
PORT=3000

# Comma-separated list of browser origins allowed to call the API.
# Requests without an Origin header (curl, health checks) are always allowed.
ALLOWED_ORIGINS=http://localhost:5173,https://react-node-url-mdata-fetch-dotanv.netlify.app

# Batch and network limits.
MAX_URLS_PER_REQUEST=20
FETCH_TIMEOUT_MS=10000
MAX_HTML_BYTES=2097152
MAX_REDIRECTS=5
FETCH_CONCURRENCY=5

# Rate limiting for POST /fetch-metadata.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# DANGEROUS — local development only. Allows the server to fetch loopback and
# RFC1918 addresses. Link-local and multicast stay blocked either way.
# ALLOW_PRIVATE_ADDRESSES=false
