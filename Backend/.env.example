# Port the API listens on. Most hosts (Render, Railway, Fly) inject this.
PORT=3000

# npm run dev sets NODE_ENV=development; deployments should set production.
# Only exact development/test enable local CORS defaults and detailed 500 errors.

# Comma-separated list of browser origins allowed to call the API.
# Requests without an Origin header (curl, health checks) are always allowed.
ALLOWED_ORIGINS=http://localhost:5173,https://react-node-url-mdata-fetch-dotanv.netlify.app

# Batch and network limits.
MAX_URLS_PER_REQUEST=20
FETCH_TIMEOUT_MS=10000
MAX_HTML_BYTES=2097152
MAX_REDIRECTS=5
FETCH_CONCURRENCY=5

# Rate limiting for POST /fetch-metadata.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
# Shared matched-Cloudflare-edge cap; uses RATE_LIMIT_WINDOW_MS above.
RATE_LIMIT_EDGE_MAX=100

# Integer 0-5 only; unset defaults to 1 (historical behavior). Invalid values
# stop startup. 0 ignores X-Forwarded-For; never use true. Measure the deployed
# proxy chain before changing this value; see README > Deployment.
TRUST_PROXY_HOPS=1

# Optional replacement for the embedded Cloudflare IPv4/IPv6 CIDRs. Unset uses
# the published list checked 2026-10-29. A nonempty comma-separated CIDR list is
# required if set; invalid values stop startup. Only use official CF networks.
# CLOUDFLARE_IP_RANGES=

# Temporary count-only proxy diagnostics for POST /fetch-metadata. Off by
# default; logs only XFF entry count and Cloudflare boundary match (no IPs).
# RATE_LIMIT_PROXY_DIAGNOSTICS=false

# DANGEROUS — requires NODE_ENV=development or NODE_ENV=test exactly.
# Ignored if NODE_ENV is unset or any other value. Permits loopback, RFC1918,
# carrier-grade NAT, and any TCP port. Link-local (including cloud metadata)
# and multicast stay blocked either way.
# True values: 1/true/yes/on, case-insensitive, with NO whitespace trimming.
# Unset and all other values (including surrounding whitespace) are false.
# ALLOW_PRIVATE_ADDRESSES=false
