{
  "name": "url-metadata-fetcher-backend",
  "version": "2.0.0",
  "description": "SSRF-safe API that extracts Open Graph / Twitter Card / HTML metadata from any public URL.",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "cross-env NODE_ENV=development node --watch server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --watch",
    "test:runtime": "node scripts/runtime-smoke.js"
  },
  "keywords": [
    "metadata",
    "open-graph",
    "opengraph",
    "twitter-card",
    "scraper",
    "express"
  ],
  "author": "Dotan Veretzky",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/server.test.js"
    ]
  }
}
